<Window x:Class="NetRoute.App.AdapterPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/NetRouteWidget.ico"
        Title="Choose adapters" Width="560" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        FontFamily="Segoe UI" FontSize="12" ThemeMode="System"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <Style x:Key="EnabledSwitch" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FocusBorder" Padding="3" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                        Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                                             Fill="{DynamicResource TextPrimary}" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="Off" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="StateText" Property="Text" Value="On" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="DetectButton" DockPanel.Dock="Left" Content="Detect automatically" Padding="8,2" Click="OnDetect" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" />
                    <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                       Text="Detect fills each box with what it finds: the phone by its USB-tethering driver, the LAN as the cable with a gateway, Wi-Fi as the wireless adapter. You can still change any of them." />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Warning}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="An adapter can fill only one slot" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Phone (carries internet in Phone mode)" FontWeight="SemiBold" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PhoneBox" Grid.Column="0" DisplayMemberPath="Label" SelectionChanged="OnPhoneChanged" />
                    <ToggleButton x:Name="PhoneEnabled" Grid.Column="2" Content="Enabled" Style="{StaticResource EnabledSwitch}" AutomationProperties.Name="Phone enabled" />
                </Grid>
                <TextBlock x:Name="PhoneDetail" Margin="0,2,0,12" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />

                <TextBlock Text="LAN (printer, NAS, other PCs)" FontWeight="SemiBold" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LanBox" Grid.Column="0" DisplayMemberPath="Label" SelectionChanged="OnLanChanged" />
                    <ToggleButton x:Name="LanEnabled" Grid.Column="2" Content="Enabled" Style="{StaticResource EnabledSwitch}" AutomationProperties.Name="LAN enabled" />
                </Grid>
                <TextBlock x:Name="LanDetail" Margin="0,2,0,12" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />

                <TextBlock Text="Wi-Fi" FontWeight="SemiBold" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="WifiAdapterBox" Grid.Column="0" DisplayMemberPath="Label" SelectionChanged="OnWifiChanged" />
                    <ComboBox x:Name="WifiNetworkBox" Grid.Column="2" IsEnabled="False" DisplayMemberPath="Label" />
                    <ToggleButton x:Name="WifiEnabled" Grid.Column="4" Content="Enabled" Style="{StaticResource EnabledSwitch}" AutomationProperties.Name="Wi-Fi enabled" />
                </Grid>
                <TextBlock x:Name="WifiDetail" Margin="0,2,0,12" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
