<Window x:Class="NetRoute.App.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/NetRouteWidget.ico"
        Title="NetRoute Widget" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The live speed through one exit, left of its latency; collapsed (so the row is unchanged) while there is none. -->
        <Style x:Key="Speed" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Today's total data through one exit, right of its latency; collapsed (so the row is unchanged) while there is none. -->
        <Style x:Key="Total" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Padding="12,10" BorderThickness="1"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}">
        <StackPanel>
            <DockPanel Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Click="OnHide" ToolTip="Hide to tray" />
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Content="⋮" Style="{StaticResource IconButton}" Click="OnMenu" ToolTip="Options">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OptionsMenu">
                            <MenuItem x:Name="StartWithWindowsItem" Header="Start with Windows" IsCheckable="True" Click="OnStartWithWindows" />
                            <MenuItem x:Name="AutoHealItem" Header="Switch automatically when a connection has no internet" IsCheckable="True" Click="OnAutoHeal" />
                            <MenuItem Header="Choose adapters…" Click="OnChooseAdapters" />
                            <MenuItem Header="Open network settings" Click="OnOpenNetworkSettings" />
                            <Separator />
                            <MenuItem Header="Quit" Click="OnQuit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="9.5" Opacity="0.45"
                           Margin="8,1,2,0" />
                <TextBlock x:Name="Header" FontSize="13" FontWeight="SemiBold" Style="{StaticResource Primary}" TextTrimming="CharacterEllipsis"
                           Cursor="Hand" ToolTip="Open the network path map: see where the connection breaks">
                    <TextBlock.TextDecorations>
                        <!-- A dotted underline marks the status line as a link. A constant brush: dynamic resources do not work inside a Pen here. -->
                        <TextDecoration Location="Underline" PenOffset="3">
                            <TextDecoration.Pen>
                                <Pen Brush="#80808080" Thickness="1"><Pen.DashStyle><DashStyle Dashes="1,2" /></Pen.DashStyle></Pen>
                            </TextDecoration.Pen>
                        </TextDecoration>
                    </TextBlock.TextDecorations>
                </TextBlock>
            </DockPanel>
            <TextBlock x:Name="Note" Visibility="Collapsed" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />

            <Border Height="1" Margin="0,8" Background="{DynamicResource CardBorder}" />

            <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PhoneRowDef" Height="22" />
                    <RowDefinition x:Name="LanRowDef" Height="22" />
                    <!-- Height starts at 0 (not 22+Collapsed cells): a fixed row height would leave an empty band
                         below the LAN row while Wi-Fi isn't configured. Render sets this to 22 once Wi-Fi is used. -->
                    <RowDefinition x:Name="WifiRowDef" Height="0" />
                </Grid.RowDefinitions>
                <!-- Each row's dot is also its on/off switch; the transparent Border is a larger hit area than the 9 px dot. -->
                <Border x:Name="PhoneDotHit" Background="Transparent" Cursor="Hand" Tag="Phone" MouseLeftButtonDown="OnDotDown">
                    <Ellipse x:Name="PhoneDot" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="PhoneLabel" Grid.Column="1" Style="{StaticResource Primary}" />
                <TextBlock x:Name="PhoneAddress" Grid.Column="2" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="PhoneSpeed" Grid.Column="3" Style="{StaticResource Speed}" Visibility="Collapsed" />
                <TextBlock x:Name="PhoneLatency" Grid.Column="4" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="PhoneTotal" Grid.Column="5" Style="{StaticResource Total}" Visibility="Collapsed"
                           ToolTip="Data through the phone today (measured by Smart routing)" />
                <Border x:Name="LanDotHit" Grid.Row="1" Background="Transparent" Cursor="Hand" Tag="Lan" MouseLeftButtonDown="OnDotDown">
                    <Ellipse x:Name="LanDot" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="LanLabel" Grid.Row="1" Grid.Column="1" Style="{StaticResource Primary}" />
                <TextBlock x:Name="LanAddress" Grid.Row="1" Grid.Column="2" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="LanSpeed" Grid.Row="1" Grid.Column="3" Style="{StaticResource Speed}" Visibility="Collapsed" />
                <TextBlock x:Name="LanLatency" Grid.Row="1" Grid.Column="4" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="LanTotal" Grid.Row="1" Grid.Column="5" Style="{StaticResource Total}" Visibility="Collapsed"
                           ToolTip="Data through the LAN today (measured by Smart routing)" />
                <Border x:Name="WifiDotHit" Grid.Row="2" Background="Transparent" Cursor="Hand" Tag="Wifi" MouseLeftButtonDown="OnDotDown" Visibility="Collapsed">
                    <Ellipse x:Name="WifiDot" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="WifiLabel" Grid.Row="2" Grid.Column="1" Style="{StaticResource Primary}" Visibility="Collapsed" />
                <TextBlock x:Name="WifiAddress" Grid.Row="2" Grid.Column="2" Style="{StaticResource Secondary}" Visibility="Collapsed" />
                <TextBlock x:Name="WifiSpeed" Grid.Row="2" Grid.Column="3" Style="{StaticResource Speed}" Visibility="Collapsed" />
                <TextBlock x:Name="WifiLatency" Grid.Row="2" Grid.Column="4" Style="{StaticResource Secondary}" Visibility="Collapsed" />
                <TextBlock x:Name="WifiTotal" Grid.Row="2" Grid.Column="5" Style="{StaticResource Total}" Visibility="Collapsed"
                           ToolTip="Data through Wi-Fi today (measured by Smart routing)" />
            </Grid>

            <Border Height="1" Margin="0,8" Background="{DynamicResource CardBorder}" />

            <UniformGrid x:Name="ModeGrid" Columns="3">
                <ToggleButton x:Name="PhoneButton" Content="Phone" Tag="Phone" Style="{StaticResource ModeButton}" Click="OnMode"
                              ToolTip="Everything through the phone. With Smart on: your LAN list (and update downloads) go through the LAN" />
                <ToggleButton x:Name="LanButton" Content="LAN" Tag="Lan" Style="{StaticResource ModeButton}" Click="OnMode"
                              ToolTip="Everything through the LAN. With Smart on: your phone list (AI tools, Omantel) goes through the phone" />
                <ToggleButton x:Name="WifiButton" Content="Wi-Fi" Tag="Wifi" Style="{StaticResource ModeButton}" Click="OnMode" Visibility="Collapsed"
                              ToolTip="Everything through Wi-Fi. Smart routing pauses on Wi-Fi until a later update" />
                <ToggleButton x:Name="SmartButton" Content="⚡ Smart" Style="{StaticResource ModeButton}" Click="OnSmart"
                              ToolTip="Smart on: the exceptions list goes the other way. Smart off: everything through the selected side only" />
            </UniformGrid>

            <Border Height="1" Margin="0,8" Background="{DynamicResource CardBorder}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⏱" Style="{StaticResource IconButton}" Click="OnSpeedTest"
                        ToolTip="Speed test of both connections (uses about 5 MB of mobile data)" />
                <Button DockPanel.Dock="Right" Content="⚙" Style="{StaticResource IconButton}" Click="OnSmartSettings"
                        ToolTip="Smart routing: choose what stays off 4G" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnPathMap"
                        ToolTip="Network path: see where the connection breaks">
                    <Viewbox Width="14" Height="14">
                        <Path Width="16" Height="16" Fill="Transparent" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M4.8,8 A1.8,1.8 0 1 1 1.2,8 A1.8,1.8 0 1 1 4.8,8 M9.8,3.5 A1.8,1.8 0 1 1 6.2,3.5 A1.8,1.8 0 1 1 9.8,3.5 M9.8,12.5 A1.8,1.8 0 1 1 6.2,12.5 A1.8,1.8 0 1 1 9.8,12.5 M14.8,8 A1.8,1.8 0 1 1 11.2,8 A1.8,1.8 0 1 1 14.8,8 M4.6,7.1 L6.5,4.7 M4.6,8.9 L6.5,11.3 M9.5,4.7 L11.5,7.1 M9.5,11.3 L11.5,8.9" />
                    </Viewbox>
                </Button>
                <TextBlock x:Name="SmartText" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           Cursor="Hand" MouseLeftButtonUp="OnSmartTextClick" Text="⚡ Smart routing off" />
            </DockPanel>
            <TextBlock x:Name="SpeedText" Visibility="Collapsed" Margin="0,4,0,0" Style="{StaticResource Secondary}" />

            <TextBlock x:Name="AdminHint" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Hyperlink Click="OnRestartAsAdmin" Foreground="{DynamicResource Warning}">Read-only — restart as admin</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
